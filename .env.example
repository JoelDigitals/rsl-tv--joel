# RSL TV – Umgebungsvariablen | Joel Digitals
# Kopieren als .env und ausfüllen

# Django
SECRET_KEY=django-insecure-bitte-langen-zufaelligen-schluessel-eintragen
DEBUG=False
RENDER_EXTERNAL_HOSTNAME=rsl-tv.onrender.com

# ── Datenbank (Supabase) ──────────────────────────────────────────────────
# Option A: DATABASE_URL (empfohlen)
DATABASE_URL=postgresql://postgres:PASSWORT@db.PROJEKT-ID.supabase.co:5432/postgres

# Option B: Einzelne Variablen (falls keine DATABASE_URL)
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=IhrSupabasePasswort
# DB_HOST=db.IHRE-PROJEKT-ID.supabase.co
# DB_PORT=5432

# ── Mailjet E-Mail ────────────────────────────────────────────────────────
MAILJET_API_KEY=IhrMailjetApiKey
MAILJET_SECRET_KEY=IhrMailjetSecretKey
DEFAULT_FROM_EMAIL=rsl@joeldigitals.de
DEFAULT_FROM_NAME=RSL TV – Joel Digitals
ADMIN_EMAIL=admin@joeldigitals.de

# ── YouTube / Twitch Stream ───────────────────────────────────────────────
YOUTUBE_CHANNEL_URL=https://www.youtube.com/embed/live_stream?channel=IHR_CHANNEL_ID
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
TWITCH_CHANNEL=IhrTwitchKanalname
TWITCH_STREAM_KEY=live_xxxxxxxxxxxx

# ── Logo Wasserzeichen ────────────────────────────────────────────────────
# Nach dem Hochladen im Admin (unter Sender-Logo) wird der Pfad automatisch gesetzt
LOGO_PATH=/pfad/zum/media/logo/rsl_logo.png
LOGO_POSITION=top_right  # top_left | top_right | bottom_left | bottom_right

# ── FFmpeg Script (separater Server) ─────────────────────────────────────
RSL_API_URL=https://rsl-tv.onrender.com
FALLBACK_VIDEO=/pfad/zu/sendepause.mp4
POLL_INTERVAL=15

# ── Bankverbindung für Rechnungen (in mail.py anpassen) ───────────────────
# IBAN=DE__ ____ ____ ____ __
# BIC=XXXXXXXX
